        "@types/react": "^18.2.48",
        "@types/react-dom": "^18.2.18",
        "@vitejs/plugin-react": "^4.2.1",
        "@vitest/ui": "^1.1.3",
        "autoprefixer": "^10.4.22",
        "eslint": "^8.56.0",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.5",
        "postcss": "^8.5.6",
        "prettier": "^3.1.1",
        "prettier-plugin-tailwindcss": "^0.5.10",
        "tailwindcss": "^3.4.18",
        "vite": "^5.0.11",
        "vitest": "^1.1.3"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"

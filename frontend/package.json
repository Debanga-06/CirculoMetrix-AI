{
    "name": "circulometrix-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "Frontend application for CirculoMetrix AI - LCA and Circular Economy Platform",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
        "format": "prettier --write \"src/**/*.{js,jsx,json,css,scss,md}\"",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@hookform/resolvers": "^3.3.4",
        "axios": "^1.6.5",
        "clsx": "^2.1.0",
        "d3": "^7.8.5",
        "date-fns": "^3.0.6",
        "framer-motion": "^10.18.0",
        "html2canvas": "^1.4.1",
        "jspdf": "^2.5.1",
        "lucide-react": "^0.303.0",
        "react": "^18.2.0",
        "react-csv": "^2.2.2",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.49.3",
        "react-hot-toast": "^2.6.0",
        "react-router-dom": "^6.30.2",
        "recharts": "^2.10.3",
        "tailwind-merge": "^2.2.0",
        "zod": "^3.22.4",
        "zustand": "^4.4.7"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.10",
